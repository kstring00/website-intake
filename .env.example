# Public site URL. Example: https://intake.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (server-side only)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_DEPOSIT_PRICE_ID=price_replace_me
# Set true only after configuring Stripe Tax in your Stripe account.
STRIPE_AUTOMATIC_TAX=false

# Optional: email the full intake to yourself using Resend.
RESEND_API_KEY=
INTAKE_NOTIFICATION_EMAIL=
INTAKE_FROM_EMAIL=Website Intake <intake@yourdomain.com>

# Optional brand/contact settings
NEXT_PUBLIC_STUDIO_NAME=Your Web Studio
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
